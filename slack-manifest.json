{
    "display_information": {
        "name": "standup-bot"
    },
    "features": {
        "bot_user": {
            "display_name": "standup-bot",
            "always_online": false
        },
        "slash_commands": [
            {
                "command": "/report",
                "description": "Send your report now",
                "should_escape": false
            },
            {
                "command": "/create_my_team",
                "description": "Create your team",
                "should_escape": false
            }
        ]
    },
    "oauth_config": {
        "scopes": {
            "bot": [
                "chat:write.public",
                "app_mentions:read",
                "chat:write",
                "im:history",
                "im:read",
                "im:write",
                "commands"
            ]
        },
        "pkce_enabled": false
    },
    "settings": {
        "event_subscriptions": {
            "bot_events": [
                "app_mention",
                "message.im"
            ]
        },
        "interactivity": {
            "is_enabled": true
        },
        "org_deploy_enabled": false,
        "socket_mode_enabled": true,
        "token_rotation_enabled": false,
        "app_level_token_rotation_enabled": false,
        "is_mcp_enabled": false
    }
}